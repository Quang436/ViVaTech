# ==========================================
# VivaArena - Environment Configuration
# ==========================================

# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database Settings (Default: SQLite local database)
DATABASE_URL=sqlite:///./viva_arena.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql://user:password@localhost:5432/viva_arena

# Vector Storage (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Speech & TTS Services (Optional external APIs, fallback to Web Speech API)
WHISPER_API_KEY=
ELEVENLABS_API_KEY=
FPT_AI_API_KEY=

# ==========================================
# Interactive Real-Time WebRTC Digital Human
# HeyGen Streaming Avatar SDK / D-ID Real-Time Agent API
# ==========================================
# 1. HeyGen Streaming Avatar (Khuyên dùng)
# Đăng ký & lấy API Key tại: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=Wayne_20240711
HEYGEN_VOICE_ID=vi-VN-NamMinhNeural

# 2. D-ID Agents & Real-Time WebRTC Streams API
# Lấy API Key tại: https://studio.d-id.com/account-settings
DID_API_KEY=
DID_AGENT_ID=
DID_PRESENTER_ID=v2_public_alex@qcvo4gupoy
DID_VOICE_ID=vi-VN-NamMinhNeural
DID_SOURCE_URL=https://raw.githubusercontent.com/Quang436/ViVaTech/main/frontend/public/professor_avatar.png
